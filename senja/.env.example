# Copy to .env and edit. Never commit .env.

# --- required -------------------------------------------------------------
# Admin login for /admin (HTTP basic auth).
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-to-something-long

# --- public identity ------------------------------------------------------
SITE_NAME=Acme
SITE_TAGLINE=What people say about working with us.
# Public origin, no trailing slash. Used for the embed snippet and for the
# absolute avatar URLs the widget loads from other domains.
SITE_URL=https://testimonials.example.com

# --- server ---------------------------------------------------------------
PORT=3000
HOST=127.0.0.1
# Express trust-proxy setting. "loopback" is right behind nginx on the same box.
TRUST_PROXY=loopback
# Where the SQLite file and uploaded avatars live. Defaults to ./data
# DATA_DIR=/var/lib/senja

# --- tuning ---------------------------------------------------------------
AVATAR_SIZE=128
MAX_UPLOAD_BYTES=8388608
# Submissions allowed per IP per hour. 0 disables the limit.
SUBMIT_RATE_LIMIT=5
# Allow avatar URLs that resolve to private/loopback addresses. Keep false.
ALLOW_PRIVATE_AVATAR_HOSTS=false
