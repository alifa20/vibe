# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Password for the dashboard. There are no user accounts. Set a long random
# one: at least 12 characters, and not a "change-me" placeholder. The server
# refuses to start without it. It also signs the session cookie, so changing
# it signs you out everywhere.
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

PORT=8000
# Bind address. 127.0.0.1 is right when a reverse proxy on the same host
# forwards to this app; use 0.0.0.0 only to reach it from another machine.
HOST=127.0.0.1

# Set to 1 only when a reverse proxy (Caddy, nginx, Cloudflare) sits in front.
# Then the first X-Forwarded-For entry is used as the visitor IP for hashing,
# and CF-IPCountry is read for the country column. Left empty, those headers
# are ignored, so nobody can fake their address by sending them.
TRUST_PROXY=

# Public origin of this server, no trailing slash, e.g. https://stats.example.com.
# Used in the tracking snippet the dashboard shows. Empty = taken from the request.
BASE_URL=

# SQLite file. Absolute, or relative to where you start the server.
DB_PATH=./data/analytics.db

# ---------------------------------------------------------------------------
# Retention
# ---------------------------------------------------------------------------

# Delete pageviews older than this many days, checked once a day.
# Empty = keep everything.
RETENTION_DAYS=
