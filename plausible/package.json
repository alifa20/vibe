{
  "name": "analytics",
  "version": "1.0.0",
  "private": true,
  "description": "Self-hosted, cookie-free web analytics: a small tracking script, daily-salted visitor counts and a password-protected dashboard",
  "type": "module",
  "main": "server.mjs",
  "scripts": {
    "start": "node server.mjs",
    "dev": "node --watch server.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^13.2.0",
    "express": "^5.3.0",
    "isbot": "^5.2.3"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.6.5",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}
