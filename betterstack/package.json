{
  "name": "uptime",
  "version": "1.0.0",
  "private": true,
  "description": "Self-hosted uptime and cron monitoring: HTTP checks, heartbeats, TLS expiry warnings and email alerts",
  "type": "module",
  "main": "server.mjs",
  "scripts": {
    "start": "node server.mjs",
    "dev": "node --watch server.mjs",
    "test": "node --test \"test/*.test.mjs\""
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.6.5",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  },
  "dependencies": {
    "better-sqlite3": "^13.2.0",
    "croner": "^11.0.1",
    "express": "^5.3.0",
    "nodemailer": "^10.6.0"
  }
}
