# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# The one admin password (at least 12 characters). It also signs the session
# cookie, so changing it signs everyone out.
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

PORT=3000
# Bind address. Keep 127.0.0.1 when a reverse proxy on the same host sits in
# front; use 0.0.0.0 only if you need to reach the app from another machine.
HOST=127.0.0.1

# Leave empty unless a reverse proxy sits in front. 1 = one proxy (Caddy or
# nginx on the same host). This decides which X-Forwarded-For entry is the
# client IP for the login lockout, and whether the cookie gets the Secure flag.
TRUST_PROXY=

# SQLite file. Created on first run.
DB_PATH=./data/uptime.db

# Public origin, no trailing slash. Only used to put links in alert emails
# and to show full ping URLs. Optional.
BASE_URL=http://127.0.0.1:3000

# ---------------------------------------------------------------------------
# Email alerts
# ---------------------------------------------------------------------------
# Leave SMTP_HOST empty to log alerts to the console instead of sending them.

SMTP_HOST=
SMTP_PORT=587
# 1 = implicit TLS (usually port 465). Empty/0 = STARTTLS (usually port 587).
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Envelope From. Must be an address your SMTP server may send as.
SMTP_FROM="Uptime <uptime@example.com>"

# Who gets the down, recovery and certificate emails.
ALERT_EMAIL_TO=you@example.com
