# Credentials for /admin (HTTP basic auth). Required — the server refuses to start without them.
ADMIN_USER=admin
ADMIN_PASS=change-me-to-something-long

# Port and bind address.
PORT=3000
HOST=0.0.0.0

# Public origin, used when printing short links (e.g. https://qr.example.com).
# Leave unset to derive it from the incoming request.
BASE_URL=

# SQLite file location. Defaults to ./data/qr.db
DB_PATH=./data/qr.db

# Set when running behind a reverse proxy (nginx, Caddy, Traefik) so req.protocol
# reflects the original scheme. Use the number of proxy hops, or "true" for one.
TRUST_PROXY=
