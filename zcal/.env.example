# ---------------------------------------------------------------------------
# zcal — local configuration
#
# Copy this file to `.env` and fill it in:   cp .env.example .env
# `.env` is gitignored. Never commit it. Nothing in here is ever logged.
# ---------------------------------------------------------------------------

# REQUIRED. The passphrase that unlocks the owner side of the app (/admin).
# There is exactly one user: you. Pick something long.
# Generate one:  node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
ZCAL_OWNER_PASSWORD=change-me-to-a-long-passphrase

# REQUIRED. Signs your login cookie. Changing it logs you out.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ZCAL_SESSION_SECRET=change-me-to-a-random-64-char-hex-string

# Where the SQLite database file lives. Relative paths resolve from the
# project root. This single file is all of your data — back it up, and you
# have backed up everything.
ZCAL_DATABASE_PATH=./data/zcal.db

# The origin used to build the shareable booking links you hand to people.
# For a local-only run, leave it as-is.
ZCAL_PUBLIC_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# OPTIONAL — external calendar feed
#
# zcal works fully without this. Leave it blank and you keep your calendar by
# adding busy blocks by hand or by uploading an .ics file on /admin/calendar.
#
# If you paste a read-only iCalendar (.ics) subscription URL here — Google
# Calendar calls it "Secret address in iCal format", Apple calls it a "Public
# Calendar" link — the "Sync from feed" button on /admin/calendar pulls those
# events in as busy time. It is a manual, one-way, read-only pull that you
# trigger; zcal never writes to the remote calendar and never polls it.
#
# This URL is a credential. It is stored only in this file and is never
# written to the database, the logs, or any export.
# ---------------------------------------------------------------------------
ZCAL_ICS_FEED_URL=
