{
  "name": "vibe",
  "private": true,
  "description": "Thirteen small apps built with AI, plus the GitHub Pages hub that links them.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "site:install": "node site/install-demos.mjs",
    "site:build": "node site/build.mjs",
    "site:serve": "node site/serve.mjs",
    "site:test": "node --test 'site/*.test.mjs'",
    "site:check": "node site/check-csp.mjs"
  },
  "packageManager": "pnpm@10.6.5"
}
