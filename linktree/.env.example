# Copy to .env and fill in. Never commit .env.

# --- /stats basic auth (required for the stats page to load) ---
STATS_USER=admin
STATS_PASS=change-me-to-something-long

# --- Server ---
PORT=8787
HOST=127.0.0.1

# Canonical absolute URL of the site. Used for OG tags and the OG image URL.
SITE_URL=https://links.example.com

# --- Click logging ---
# Salt for the daily-rotating visitor hash. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# If unset, a random salt is generated at boot and unique-visitor counts reset on restart.
HASH_SALT=

# Set to 1 when running behind Caddy/nginx so X-Forwarded-For is trusted.
TRUST_PROXY=1

# Where clicks are appended. Relative paths resolve from the project root.
CLICKS_LOG=data/clicks.log
