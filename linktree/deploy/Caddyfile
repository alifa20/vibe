# 	}
# 	# Copy the value from dist/headers.txt — it is a hash of the inline <style>,
# 	# so it changes every time you rebuild.
# 	header / Content-Security-Policy "default-src 'none'; img-src 'self' data: https:; style-src 'sha256-REPLACE-ME'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
#
# 	handle /go/* { reverse_proxy 127.0.0.1:8787 }
# 	handle /stats { reverse_proxy 127.0.0.1:8787 }
