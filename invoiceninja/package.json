{
  "name": "invoices",
  "version": "1.0.0",
  "private": true,
  "description": "Self-hosted invoicing: clients, line items, exact money, gap-free numbers and print-to-PDF",
  "type": "module",
  "main": "server.mjs",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.mjs",
    "dev": "node --env-file-if-exists=.env --watch server.mjs",
    "test": "node --test 'test/*.test.mjs'"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "better-sqlite3": "^13.2.0",
    "express": "^5.2.1"
  },
  "packageManager": "pnpm@10.6.5",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}
