# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# The one password for the admin. There are no user accounts. At least 12
# characters. Changing it signs every open session out.
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_PASSWORD=change-me-to-a-long-random-password

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

PORT=3000
# Bind address. 127.0.0.1 keeps the app private to this machine, which is right
# when a reverse proxy on the same host forwards to it. Use 0.0.0.0 only if you
# really need to reach it from another machine.
HOST=127.0.0.1

# How many reverse proxies sit in front of the app (1 = Caddy or nginx on the
# same host). Leave empty when nothing is in front: proxy headers are then
# ignored, so nobody can fake their IP to dodge the login lockout.
TRUST_PROXY=

# SQLite file. Created on first run, along with its folder.
DB_PATH=./data/invoices.db

# Set to 1 to always mark the session cookie Secure. Behind an HTTPS proxy with
# TRUST_PROXY set, the flag is added automatically, so this is rarely needed.
SECURE_COOKIES=
