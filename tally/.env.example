# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Single shared secret for the /admin UI. There are no user accounts.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=change-me-to-a-long-random-string

# Public origin of this app, no trailing slash. Used to build absolute links
# to forms (share links, email notifications).
BASE_URL=https://forms.example.com

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

PORT=3000
# Bind address. 127.0.0.1 is correct when Caddy proxies to this app on the
# same host; use 0.0.0.0 only if you need to reach it from another machine.
HOST=127.0.0.1

# Number of reverse proxies in front of the app. 1 = Caddy on the same host.
# This controls which X-Forwarded-For entry is trusted as the client IP.
TRUST_PROXY=1

# Absolute or relative paths. Defaults shown.
DB_PATH=./data/forms.db
UPLOAD_DIR=./uploads

# Set to 1 only if you terminate TLS elsewhere and serve the admin over plain
# HTTP (e.g. an SSH tunnel). Leaving it unset keeps the Secure cookie flag on.
INSECURE_COOKIES=

# ---------------------------------------------------------------------------
# Spam controls
# ---------------------------------------------------------------------------

# Max submissions per IP per form within the window.
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MINUTES=10

# ---------------------------------------------------------------------------
# Uploads
# ---------------------------------------------------------------------------

# Per-file cap in megabytes.
MAX_UPLOAD_MB=10

# ---------------------------------------------------------------------------
# Email notifications (optional)
# ---------------------------------------------------------------------------
# Leave SMTP_HOST empty to disable email notifications entirely. Forms with
# "email me" enabled will simply log a warning instead.

SMTP_HOST=
SMTP_PORT=587
# 1 = implicit TLS (usually port 465). Empty/0 = STARTTLS (usually port 587).
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=

# Envelope From. Must be an address your SMTP server is allowed to send as.
SMTP_FROM="Forms <forms@example.com>"

# Default recipient for response notifications. Each form can override this.
NOTIFY_EMAIL_TO=you@example.com
